# Which model drafts, critiques and revises: gemini | openai | offline
LLM_PROVIDER=gemini

# Google Gemini - free API key from https://aistudio.google.com (no billing needed for the free tier)
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI (optional, billed per token)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional: real web search instead of the local notes (pip install -e ".[tavily]"; uses Tavily credits)
# TAVILY_API_KEY=

# Optional: keep every round in a local SQLite file (default: in memory)
# CHECKPOINT_DB=runs.sqlite
